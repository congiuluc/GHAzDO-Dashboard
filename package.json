{
  "name": "ghazdo-security-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Azure DevOps extension that consolidates GitHub Advanced Security for Azure DevOps alerts across projects.",
  "workspaces": [
    "packages/shared",
    "apps/extension",
    "apps/functions",
    "apps/docs"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace apps/extension && npm run build --workspace apps/functions && npm run build --workspace apps/docs",
    "docs:dev": "npm run dev --workspace apps/docs",
    "docs:build": "npm run build --workspace apps/docs",
    "package:vsix": "npm run package --workspace apps/extension",
    "package:functions": "npm run package --workspace apps/functions",
    "bicep:build": "az bicep build --file infra/main.bicep --outdir infra/out",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "glob": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "pptxgenjs": {
      "image-size": "^2.0.3"
    }
  }
}
