    "react-dom": "^18.3.1",
    "azure-devops-ui": "^2.282.0"
  },
  "devDependencies": {
    "@ghazdo/shared": "1.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "tfx-cli": "^0.24.2",
    "vite": "^8.0.0"
  }
